{
  "name": "pyfl",
  "version": "2.1.0",
  "description": "获取拼音首字母",
  "main": "./dist/pyfl.min.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "webpack && tsc --emitDeclarationOnly && node scripts/copy-types.cjs",
    "test": "tsx --test test/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:experimental": "tsc -p experimental/initials/tsconfig.json && tsx --test experimental/initials/test/*.spec.ts",
    "measure:experimental": "node experimental/initials/measure.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run typecheck && npm test && npm run test:experimental && npm run build && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist/pyfl.min.js",
    "dist/index.mjs",
    "types/index.d.ts",
    "types/index.d.mts",
    "THIRD_PARTY_NOTICES",
    "CHANGELOG.md",
    "dist/modern/*.cjs",
    "dist/modern/*.mjs",
    "types/modern/common*.d.ts",
    "types/modern/common*.d.mts",
    "types/modern/full*.d.ts",
    "types/modern/full*.d.mts",
    "types/modern/runtime.d.ts",
    "types/modern/runtime.d.mts",
    "docs/modern.md",
    "README_zh-CN.md",
    "README_en.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxino/pyfl.git"
  },
  "keywords": [
    "pinyin",
    "拼音",
    "首拼",
    "中文首拼"
  ],
  "author": "yuxino",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yuxino/pyfl/issues"
  },
  "homepage": "https://pyfl.yuxino.cn",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webpack": "^5.109.1",
    "webpack-cli": "^7.2.1"
  },
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./dist/pyfl.min.js"
      }
    },
    "./dist/pyfl.min": "./dist/pyfl.min.js",
    "./dist/*": "./dist/*",
    "./types/*": "./types/*",
    "./package.json": "./package.json",
    "./modern": {
      "import": {
        "types": "./types/modern/common-phrases.d.mts",
        "default": "./dist/modern/common-phrases.mjs"
      },
      "require": {
        "types": "./types/modern/common-phrases.d.ts",
        "default": "./dist/modern/common-phrases.cjs"
      }
    },
    "./modern/common": {
      "import": {
        "types": "./types/modern/common.d.mts",
        "default": "./dist/modern/common.mjs"
      },
      "require": {
        "types": "./types/modern/common.d.ts",
        "default": "./dist/modern/common.cjs"
      }
    },
    "./modern/common-phrases": {
      "import": {
        "types": "./types/modern/common-phrases.d.mts",
        "default": "./dist/modern/common-phrases.mjs"
      },
      "require": {
        "types": "./types/modern/common-phrases.d.ts",
        "default": "./dist/modern/common-phrases.cjs"
      }
    },
    "./modern/full": {
      "import": {
        "types": "./types/modern/full.d.mts",
        "default": "./dist/modern/full.mjs"
      },
      "require": {
        "types": "./types/modern/full.d.ts",
        "default": "./dist/modern/full.cjs"
      }
    },
    "./modern/full-phrases": {
      "import": {
        "types": "./types/modern/full-phrases.d.mts",
        "default": "./dist/modern/full-phrases.mjs"
      },
      "require": {
        "types": "./types/modern/full-phrases.d.ts",
        "default": "./dist/modern/full-phrases.cjs"
      }
    },
    "./modern/common-search": {
      "import": {
        "types": "./types/modern/common-search.d.mts",
        "default": "./dist/modern/common-search.mjs"
      },
      "require": {
        "types": "./types/modern/common-search.d.ts",
        "default": "./dist/modern/common-search.cjs"
      }
    },
    "./modern/full-search": {
      "import": {
        "types": "./types/modern/full-search.d.mts",
        "default": "./dist/modern/full-search.mjs"
      },
      "require": {
        "types": "./types/modern/full-search.d.ts",
        "default": "./dist/modern/full-search.cjs"
      }
    }
  },
  "sideEffects": false
}
