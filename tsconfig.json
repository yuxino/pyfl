{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "types",
    "outDir": "./dist",
    "removeComments": false,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"]
}
